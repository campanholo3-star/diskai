# Supabase Credentials (Gerenciado no painel supabase.com -> Project Settings -> API)
VITE_SUPABASE_URL=https://jctgmpnlyuuiqdiasvul.supabase.co
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# LiveKit Cloud ou LiveKit Server (https://cloud.livekit.io)
# URL WebSocket do LiveKit (ex: wss://seu-projeto-1234.livekit.cloud)
VITE_LIVEKIT_URL=wss://sua_url_livekit_aqui.livekit.cloud

# Chaves de API do LiveKit (usadas pela Supabase Edge Function ou Backend para gerar Access Token)
LIVEKIT_API_KEY=sua_chave_aqui
LIVEKIT_API_SECRET=sua_senha_secreta_aqui

# (Opcional para Dev Local): Chaves acessíveis no client se quiser testar tokens direto no browser sem rodar Edge Function
VITE_LIVEKIT_API_KEY=sua_chave_aqui
VITE_LIVEKIT_API_SECRET=sua_senha_secreta_aqui
